# Template for /etc/prezenty/prezenty.env (setup-vm.sh fills in the two
# generated values). Plain KEY=value lines, no quotes. Never commit real values.
NODE_ENV=production
PORT=3000
# Only Caddy (on this machine) talks to the app
HOST=127.0.0.1

# Database on this machine
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=prezenty
DB_NAME=prezenty
DB_PASSWORD=__DB_PASSWORD__

# Changing this logs everybody out once
SESSION_SECRET=__SESSION_SECRET__

# GIFs (optional; copy the values from the Render dashboard)
#KLIPY_API_KEY=
#GIPHY_API_KEY=
#GIF_PROVIDER=klipy

# Push notifications: leave unset to keep working with the keys the app ships
# with (as on Render today). Rotating them makes every device subscribe again;
# see DEPLOYMENT.md "Rotating secrets".
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
