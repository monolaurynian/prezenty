{
  "name": "prezenty",
  "version": "1.0.0",
  "description": "Aplikacja do zarządzania pomysłami na prezenty świąteczne",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "offline": "node tests/helpers/start-demo-server.js --foreground",
    "build": "echo 'No build step required'",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report tests/.report",
    "postinstall": "echo 'Dependencies installed successfully'",
    "init-db": "node scripts/init-db.js",
    "test-db": "node scripts/test-db.js",
    "optimize-db": "node scripts/optimize-db.js"
  },
  "keywords": [
    "christmas",
    "presents",
    "polish",
    "gifts",
    "nodejs",
    "express",
    "mysql"
  ],
  "author": "Prezenty App",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cron": "^3.1.6",
    "dotenv": "^17.0.1",
    "express": "^4.18.2",
    "express-mysql-session": "^3.0.1",
    "express-session": "^1.17.3",
    "multer": "^2.0.1",
    "mysql2": "^3.6.5",
    "path": "^0.12.7",
    "sharp": "^0.34.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^4.1.3",
    "@playwright/test": "1.61.0",
    "cssnano": "^7.0.7",
    "nodemon": "^3.0.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/username/prezenty.git"
  }
}
